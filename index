<!DOCTYPE html>
<html lang="es">
<head>
  <base target="_top">
  <meta charset="utf-8">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --tinta:      #1B2430;
      --tinta-suave:#5B6874;
      --linea:      #DFE3E8;
      --fondo:      #F2F4F6;
      --superficie: #FFFFFF;
      --acento:     #1F5FA8;
      --acento-bajo:#E8EFF7;
      --alerta:     #A83232;
      --ok:         #2E7D5B;
      --radio: 3px;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--fondo);
      color: var(--tinta);
      font-family: 'IBM Plex Sans', system-ui, sans-serif;
      font-size: 14px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    .num { font-family: 'IBM Plex Mono', ui-monospace, monospace; font-variant-numeric: tabular-nums; }

    /* --- Encabezado ---------------------------------------------------- */
    header {
      background: var(--superficie);
      border-bottom: 1px solid var(--linea);
      padding: 18px 24px 0;
      position: sticky; top: 0; z-index: 20;
    }
    .barra {
      display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap;
      max-width: 1180px; margin: 0 auto;
    }
    h1 { font-size: 19px; font-weight: 600; margin: 0; letter-spacing: -.01em; }
    .selector-hoja {
      font: inherit; color: var(--tinta-suave);
      border: 1px solid var(--linea); background: var(--superficie);
      border-radius: var(--radio); padding: 4px 8px;
    }
    .estado { margin-left: auto; font-size: 12.5px; color: var(--tinta-suave); }

    nav {
      display: flex; gap: 4px; max-width: 1180px; margin: 14px auto 0;
    }
    nav button {
      font: inherit; font-weight: 500;
      background: none; border: none; cursor: pointer;
      padding: 9px 14px; color: var(--tinta-suave);
      border-bottom: 2px solid transparent; margin-bottom: -1px;
    }
    nav button:hover { color: var(--tinta); }
    nav button[aria-selected="true"] { color: var(--acento); border-bottom-color: var(--acento); }
    nav button:focus-visible, .selector-hoja:focus-visible { outline: 2px solid var(--acento); outline-offset: 2px; }

    main { max-width: 1180px; margin: 0 auto; padding: 24px; }
    .vista[hidden] { display: none; }

    /* --- Tarjetas ------------------------------------------------------ */
    .panel {
      background: var(--superficie);
      border: 1px solid var(--linea);
      border-radius: var(--radio);
    }
    .panel > h2 {
      font-size: 13px; font-weight: 600; margin: 0;
      padding: 12px 16px; border-bottom: 1px solid var(--linea);
      color: var(--tinta-suave);
    }
    .panel > .cuerpo { padding: 16px; }

    .grilla-kpi {
      display: grid; gap: 12px; margin-bottom: 20px;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    }
    .kpi {
      background: var(--superficie); border: 1px solid var(--linea);
      border-radius: var(--radio); padding: 14px 16px;
    }
    .kpi .etiqueta { font-size: 12.5px; color: var(--tinta-suave); }
    .kpi .valor { font-size: 26px; font-weight: 500; letter-spacing: -.02em; margin-top: 2px; }
    .kpi .detalle { font-size: 12px; color: var(--tinta-suave); margin-top: 6px; }

    .grilla-graficos { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }

    .barras { display: grid; gap: 9px; }
    .barra-fila { display: grid; grid-template-columns: minmax(70px, 30%) 1fr auto; gap: 10px; align-items: center; }
    .barra-fila .etq { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; }
    .pista { background: var(--acento-bajo); height: 16px; border-radius: 2px; overflow: hidden; }
    .relleno { background: var(--acento); height: 100%; width: 0; transition: width .5s ease; }
    .barra-fila .cant { font-size: 13px; color: var(--tinta-suave); }

    .columnas { display: flex; align-items: flex-end; gap: 6px; height: 150px; }
    .columnas .col { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 6px; }
    .columnas .marca { background: var(--acento); width: 100%; min-height: 2px; border-radius: 2px 2px 0 0; }
    .columnas .pie { font-size: 10.5px; color: var(--tinta-suave); writing-mode: vertical-rl; }

    /* --- Tabla --------------------------------------------------------- */
    .herramientas { display: flex; gap: 10px; align-items: center; margin-bottom: 14px; flex-wrap: wrap; }
    input[type="search"], input[type="text"], input[type="number"], input[type="date"], select, textarea {
      font: inherit; color: var(--tinta);
      border: 1px solid var(--linea); border-radius: var(--radio);
      padding: 7px 10px; background: var(--superficie); width: 100%;
    }
    input:focus, select:focus, textarea:focus { outline: 2px solid var(--acento); outline-offset: -1px; border-color: var(--acento); }
    .busqueda { max-width: 300px; }

    .envoltorio-tabla { overflow-x: auto; }
    table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
    th, td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--linea); white-space: nowrap; }
    th { font-size: 12px; font-weight: 600; color: var(--tinta-suave); background: var(--superficie); position: sticky; top: 0; cursor: pointer; user-select: none; }
    th:hover { color: var(--tinta); }
    th .flecha { opacity: .4; font-size: 10px; }
    tbody tr:hover { background: #F8FAFB; }
    td.acciones { white-space: nowrap; }

    button.accion {
      font: inherit; font-size: 12.5px; background: none;
      border: 1px solid var(--linea); border-radius: var(--radio);
      padding: 3px 9px; cursor: pointer; color: var(--tinta-suave);
    }
    button.accion:hover { border-color: var(--acento); color: var(--acento); }
    button.accion.riesgo:hover { border-color: var(--alerta); color: var(--alerta); }

    /* --- Formulario ---------------------------------------------------- */
    .grilla-form { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
    .campo label { display: block; font-size: 12.5px; color: var(--tinta-suave); margin-bottom: 4px; }
    .pie-form { display: flex; gap: 10px; align-items: center; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--linea); }

    .btn {
      font: inherit; font-weight: 500; cursor: pointer;
      border-radius: var(--radio); padding: 8px 16px;
      border: 1px solid var(--acento); background: var(--acento); color: #fff;
    }
    .btn:hover { background: #1A5293; }
    .btn[disabled] { opacity: .55; cursor: default; }
    .btn.secundario { background: var(--superficie); color: var(--tinta); border-color: var(--linea); }
    .btn.secundario:hover { background: var(--fondo); }

    .vacio { padding: 40px 16px; text-align: center; color: var(--tinta-suave); }
    .vacio p { margin: 0 0 14px; }

    .aviso {
      position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%) translateY(20px);
      background: var(--tinta); color: #fff; padding: 10px 18px;
      border-radius: var(--radio); font-size: 13.5px;
      opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s; z-index: 50;
    }
    .aviso.visible { opacity: 1; transform: translateX(-50%) translateY(0); }
    .aviso.error { background: var(--alerta); }

    .velo {
      position: fixed; inset: 0; background: rgba(27, 36, 48, .45);
      display: flex; align-items: center; justify-content: center; padding: 20px; z-index: 40;
    }
    .velo[hidden] { display: none; }
    .modal { background: var(--superficie); border-radius: var(--radio); width: 100%; max-width: 620px; max-height: 88vh; overflow-y: auto; }
    .modal h2 { font-size: 15px; margin: 0; padding: 16px; border-bottom: 1px solid var(--linea); }
    .modal .cuerpo { padding: 16px; }

    @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    @media (max-width: 640px) {
      main, header { padding-left: 14px; padding-right: 14px; }
      .columnas .pie { display: none; }
    }
  </style>
</head>
<body>

<header>
  <div class="barra">
    <h1 id="titulo">Panel de gestión</h1>
    <select class="selector-hoja" id="selectorHoja" onchange="cambiarHoja()" aria-label="Elegir pestaña"></select>
    <span class="estado" id="estado">Cargando…</span>
  </div>
  <nav role="tablist">
    <button role="tab" id="tab-panel" aria-selected="true" onclick="mostrar('panel')">Resumen</button>
    <button role="tab" id="tab-datos" aria-selected="false" onclick="mostrar('datos')">Registros</button>
    <button role="tab" id="tab-nuevo" aria-selected="false" onclick="mostrar('nuevo')">Cargar registro</button>
  </nav>
</header>

<main>
  <section class="vista" id="vista-panel">
    <div class="grilla-kpi" id="kpis"></div>
    <div class="grilla-graficos" id="graficos"></div>
  </section>

  <section class="vista" id="vista-datos" hidden>
    <div class="herramientas">
      <input type="search" class="busqueda" id="busqueda" placeholder="Buscar en todos los campos" oninput="pintarTabla()">
      <span class="estado num" id="contadorFilas"></span>
      <button class="btn secundario" style="margin-left:auto" onclick="recargar()">Actualizar</button>
    </div>
    <div class="panel"><div class="envoltorio-tabla" id="contenedorTabla"></div></div>
  </section>

  <section class="vista" id="vista-nuevo" hidden>
    <div class="panel" style="max-width:820px">
      <h2>Nuevo registro</h2>
      <div class="cuerpo">
        <div class="grilla-form" id="formNuevo"></div>
        <div class="pie-form">
          <button class="btn" id="btnGuardar" onclick="guardarNuevo()">Guardar registro</button>
          <button class="btn secundario" onclick="limpiarFormulario()">Limpiar</button>
        </div>
      </div>
    </div>
  </section>
</main>

<div class="velo" id="velo" hidden onclick="if(event.target===this) cerrarEdicion()">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="tituloEdicion">
    <h2 id="tituloEdicion">Editar registro</h2>
    <div class="cuerpo">
      <div class="grilla-form" id="formEdicion"></div>
      <div class="pie-form">
        <button class="btn" id="btnActualizar" onclick="guardarEdicion()">Guardar cambios</button>
        <button class="btn secundario" onclick="cerrarEdicion()">Cancelar</button>
      </div>
    </div>
  </div>
</div>

<div class="aviso" id="aviso"></div>

<script>
var ESTADO = { campos: [], filas: [], metricas: null, hoja: '', orden: null, ordenAsc: true, editando: null };

// ------------------------------------------------------------- Arranque
window.addEventListener('load', function () { recargar(); });

function recargar(hoja) {
  marcarEstado('Cargando…');
  google.script.run
    .withSuccessHandler(recibir)
    .withFailureHandler(fallar)
    .cargarTodo(hoja || null);
}

function recibir(datos) {
  ESTADO.campos = datos.campos;
  ESTADO.filas = datos.filas;
  ESTADO.metricas = datos.metricas;
  ESTADO.hoja = datos.hojaActual;

  document.getElementById('titulo').textContent = datos.titulo;
  pintarSelectorHojas(datos.hojas, datos.hojaActual);
  pintarPanel();
  pintarTabla();
  pintarFormulario();
  marcarEstado(datos.hojaActual + ' · ' + datos.filas.length + ' registros');
  habilitar(true);
}

function fallar(error) {
  marcarEstado('Error al cargar');
  avisar(error && error.message ? error.message : 'No se pudo completar la operación.', true);
  habilitar(true);
}

function marcarEstado(texto) { document.getElementById('estado').textContent = texto; }

function habilitar(activo) {
  ['btnGuardar', 'btnActualizar'].forEach(function (id) {
    var b = document.getElementById(id);
    if (b) b.disabled = !activo;
  });
}

function pintarSelectorHojas(hojas, actual) {
  var sel = document.getElementById('selectorHoja');
  sel.innerHTML = '';
  hojas.forEach(function (h) {
    var op = document.createElement('option');
    op.value = h; op.textContent = h; op.selected = (h === actual);
    sel.appendChild(op);
  });
  sel.style.display = hojas.length > 1 ? '' : 'none';
}

function cambiarHoja() {
  document.getElementById('busqueda').value = '';
  ESTADO.orden = null;
  recargar(document.getElementById('selectorHoja').value);
}

function mostrar(vista) {
  ['panel', 'datos', 'nuevo'].forEach(function (v) {
    document.getElementById('vista-' + v).hidden = (v !== vista);
    document.getElementById('tab-' + v).setAttribute('aria-selected', String(v === vista));
  });
}

// ------------------------------------------------------------- Resumen
function pintarPanel() {
  var m = ESTADO.metricas;
  var kpis = document.getElementById('kpis');
  var graficos = document.getElementById('graficos');
  kpis.innerHTML = '';
  graficos.innerHTML = '';

  if (!ESTADO.campos.length) {
    kpis.innerHTML = '<div class="panel"><div class="vacio"><p>Esta pestaña no tiene encabezados en la fila ' +
      '1. Agregá los nombres de columna y actualizá.</p></div></div>';
    return;
  }

  kpis.appendChild(tarjetaKpi('Registros', formatear(m.total), ESTADO.campos.length + ' campos'));

  m.numericas.forEach(function (n) {
    kpis.appendChild(tarjetaKpi(
      'Total ' + n.nombre,
      formatear(n.suma),
      'Promedio ' + formatear(n.promedio) + ' · Máx ' + formatear(n.maximo)
    ));
  });

  if (m.categoria) graficos.appendChild(graficoBarras(m.categoria));
  if (m.serie) graficos.appendChild(graficoColumnas(m.serie));
}

function tarjetaKpi(etiqueta, valor, detalle) {
  var d = document.createElement('div');
  d.className = 'kpi';
  d.innerHTML = '<div class="etiqueta"></div><div class="valor num"></div><div class="detalle num"></div>';
  d.children[0].textContent = etiqueta;
  d.children[1].textContent = valor;
  d.children[2].textContent = detalle || '';
  return d;
}

function graficoBarras(datos) {
  var panel = document.createElement('div');
  panel.className = 'panel';
  var h = document.createElement('h2');
  h.textContent = 'Distribución por ' + datos.nombre;
  var cuerpo = document.createElement('div');
  cuerpo.className = 'cuerpo';
  var cont = document.createElement('div');
  cont.className = 'barras';

  var tope = Math.max.apply(null, datos.items.map(function (i) { return i.cantidad; }));
  datos.items.forEach(function (item) {
    var fila = document.createElement('div');
    fila.className = 'barra-fila';
    fila.innerHTML = '<span class="etq"></span><div class="pista"><div class="relleno"></div></div><span class="cant num"></span>';
    fila.querySelector('.etq').textContent = item.etiqueta;
    fila.querySelector('.etq').title = item.etiqueta;
    fila.querySelector('.cant').textContent = item.cantidad;
    cont.appendChild(fila);
    requestAnimationFrame(function () {
      fila.querySelector('.relleno').style.width = (item.cantidad / tope * 100) + '%';
    });
  });

  cuerpo.appendChild(cont);
  panel.appendChild(h); panel.appendChild(cuerpo);
  return panel;
}

function graficoColumnas(datos) {
  var panel = document.createElement('div');
  panel.className = 'panel';
  var h = document.createElement('h2');
  h.textContent = 'Registros por mes según ' + datos.nombre;
  var cuerpo = document.createElement('div');
  cuerpo.className = 'cuerpo';
  var cont = document.createElement('div');
  cont.className = 'columnas';

  var tope = Math.max.apply(null, datos.puntos.map(function (p) { return p.cantidad; }));
  datos.puntos.forEach(function (p) {
    var col = document.createElement('div');
    col.className = 'col';
    col.title = p.etiqueta + ': ' + p.cantidad;
    col.innerHTML = '<span class="cant num" style="font-size:11px;color:var(--tinta-suave)"></span>' +
                    '<div class="marca"></div><span class="pie"></span>';
    col.querySelector('.cant').textContent = p.cantidad;
    col.querySelector('.pie').textContent = p.etiqueta;
    col.querySelector('.marca').style.height = Math.max(2, p.cantidad / tope * 105) + 'px';
    cont.appendChild(col);
  });

  cuerpo.appendChild(cont);
  panel.appendChild(h); panel.appendChild(cuerpo);
  return panel;
}

function formatear(n) {
  if (typeof n !== 'number' || isNaN(n)) return '—';
  var decimales = Number.isInteger(n) ? 0 : 2;
  return n.toLocaleString('es-AR', { minimumFractionDigits: decimales, maximumFractionDigits: decimales });
}

// ------------------------------------------------------------- Registros
function filasFiltradas() {
  var q = document.getElementById('busqueda').value.trim().toLowerCase();
  var lista = ESTADO.filas.slice();

  if (q) {
    lista = lista.filter(function (r) {
      return ESTADO.campos.some(function (c) {
        return String(r.valores[c.nombre] || '').toLowerCase().indexOf(q) !== -1;
      });
    });
  }

  if (ESTADO.orden) {
    var campo = ESTADO.orden;
    var signo = ESTADO.ordenAsc ? 1 : -1;
    lista.sort(function (a, b) {
      var x = a.valores[campo], y = b.valores[campo];
      if (typeof x === 'number' && typeof y === 'number') return (x - y) * signo;
      return String(x).localeCompare(String(y), 'es', { numeric: true }) * signo;
    });
  }
  return lista;
}

function pintarTabla() {
  var cont = document.getElementById('contenedorTabla');
  cont.innerHTML = '';

  if (!ESTADO.campos.length) {
    cont.innerHTML = '<div class="vacio"><p>No hay columnas para mostrar.</p></div>';
    return;
  }

  var lista = filasFiltradas();
  document.getElementById('contadorFilas').textContent =
    lista.length + ' de ' + ESTADO.filas.length;

  if (!lista.length) {
    cont.innerHTML = '<div class="vacio"><p>Ningún registro coincide con la búsqueda.</p>' +
      '<button class="btn secundario" onclick="document.getElementById(\'busqueda\').value=\'\';pintarTabla()">Ver todos</button></div>';
    return;
  }

  var tabla = document.createElement('table');
  var thead = document.createElement('thead');
  var trh = document.createElement('tr');

  ESTADO.campos.forEach(function (c) {
    var th = document.createElement('th');
    th.textContent = c.nombre + ' ';
    if (ESTADO.orden === c.nombre) {
      var f = document.createElement('span');
      f.className = 'flecha';
      f.textContent = ESTADO.ordenAsc ? '▲' : '▼';
      th.appendChild(f);
    }
    th.onclick = function () { ordenarPor(c.nombre); };
    trh.appendChild(th);
  });
  var thAcc = document.createElement('th');
  thAcc.textContent = '';
  thAcc.onclick = null;
  thAcc.style.cursor = 'default';
  trh.appendChild(thAcc);
  thead.appendChild(trh);

  var tbody = document.createElement('tbody');
  lista.forEach(function (registro) {
    var tr = document.createElement('tr');
    ESTADO.campos.forEach(function (c) {
      var td = document.createElement('td');
      var valor = registro.visibles ? registro.visibles[c.indice] : registro.valores[c.nombre];
      td.textContent = (valor === '' || valor === null || valor === undefined) ? '—' : valor;
      if (c.tipo === 'numero') td.className = 'num';
      tr.appendChild(td);
    });

    var td = document.createElement('td');
    td.className = 'acciones';
    var editar = document.createElement('button');
    editar.className = 'accion'; editar.textContent = 'Editar';
    editar.onclick = function () { abrirEdicion(registro); };
    var borrar = document.createElement('button');
    borrar.className = 'accion riesgo'; borrar.textContent = 'Eliminar';
    borrar.style.marginLeft = '6px';
    borrar.onclick = function () { eliminar(registro); };
    td.appendChild(editar); td.appendChild(borrar);
    tr.appendChild(td);
    tbody.appendChild(tr);
  });

  tabla.appendChild(thead); tabla.appendChild(tbody);
  cont.appendChild(tabla);
}

function ordenarPor(campo) {
  if (ESTADO.orden === campo) ESTADO.ordenAsc = !ESTADO.ordenAsc;
  else { ESTADO.orden = campo; ESTADO.ordenAsc = true; }
  pintarTabla();
}

// ------------------------------------------------------------- Formularios
function construirCampos(contenedor, prefijo, valores) {
  contenedor.innerHTML = '';
  ESTADO.campos.forEach(function (c, i) {
    var envoltorio = document.createElement('div');
    envoltorio.className = 'campo';

    var label = document.createElement('label');
    label.textContent = c.nombre;
    label.setAttribute('for', prefijo + i);

    var entrada;
    if (c.tipo === 'categoria') {
      entrada = document.createElement('select');
      var opciones = valoresUnicos(c.nombre);
      var vacia = document.createElement('option');
      vacia.value = ''; vacia.textContent = '—';
      entrada.appendChild(vacia);
      opciones.forEach(function (o) {
        var op = document.createElement('option');
        op.value = o; op.textContent = o;
        entrada.appendChild(op);
      });
    } else {
      entrada = document.createElement('input');
      entrada.type = c.tipo === 'numero' ? 'number'
                   : c.tipo === 'fecha'  ? 'date' : 'text';
      if (c.tipo === 'numero') entrada.step = 'any';
    }

    entrada.id = prefijo + i;
    entrada.dataset.campo = c.nombre;
    if (valores) entrada.value = valores[c.nombre] === null || valores[c.nombre] === undefined ? '' : valores[c.nombre];

    envoltorio.appendChild(label);
    envoltorio.appendChild(entrada);
    contenedor.appendChild(envoltorio);
  });
}

function valoresUnicos(campo) {
  var vistos = {};
  ESTADO.filas.forEach(function (r) {
    var v = r.valores[campo];
    if (v !== '' && v !== null && v !== undefined) vistos[String(v)] = true;
  });
  return Object.keys(vistos).sort();
}

function leerCampos(contenedor) {
  var valores = {};
  contenedor.querySelectorAll('[data-campo]').forEach(function (el) {
    valores[el.dataset.campo] = el.value;
  });
  return valores;
}

function pintarFormulario() {
  construirCampos(document.getElementById('formNuevo'), 'nuevo-', null);
}

function limpiarFormulario() {
  pintarFormulario();
  avisar('Formulario limpio');
}

function guardarNuevo() {
  var valores = leerCampos(document.getElementById('formNuevo'));
  var tieneAlgo = Object.keys(valores).some(function (k) { return String(valores[k]).trim() !== ''; });
  if (!tieneAlgo) { avisar('Completá al menos un campo antes de guardar.', true); return; }

  habilitar(false);
  marcarEstado('Guardando…');
  google.script.run
    .withSuccessHandler(function (datos) {
      recibir(datos);
      pintarFormulario();
      avisar('Registro guardado');
      mostrar('datos');
    })
    .withFailureHandler(fallar)
    .crearRegistro(ESTADO.hoja, valores);
}

function abrirEdicion(registro) {
  ESTADO.editando = registro;
  construirCampos(document.getElementById('formEdicion'), 'editar-', registro.valores);
  document.getElementById('velo').hidden = false;
  var primero = document.querySelector('#formEdicion [data-campo]');
  if (primero) primero.focus();
}

function cerrarEdicion() {
  document.getElementById('velo').hidden = true;
  ESTADO.editando = null;
}

function guardarEdicion() {
  if (!ESTADO.editando) return;
  var valores = leerCampos(document.getElementById('formEdicion'));
  var idOriginal = ESTADO.editando.valores['ID'];

  habilitar(false);
  marcarEstado('Guardando…');
  google.script.run
    .withSuccessHandler(function (datos) {
      cerrarEdicion();
      recibir(datos);
      avisar('Cambios guardados');
    })
    .withFailureHandler(function (e) { cerrarEdicion(); fallar(e); })
    .actualizarRegistro(ESTADO.hoja, ESTADO.editando.fila, valores, idOriginal === undefined ? '' : idOriginal);
}

function eliminar(registro) {
  var primero = ESTADO.campos.length ? registro.valores[ESTADO.campos[0].nombre] : '';
  if (!confirm('¿Eliminar el registro "' + primero + '"? No se puede deshacer.')) return;

  marcarEstado('Eliminando…');
  google.script.run
    .withSuccessHandler(function (datos) { recibir(datos); avisar('Registro eliminado'); })
    .withFailureHandler(fallar)
    .eliminarRegistro(ESTADO.hoja, registro.fila, registro.valores['ID'] === undefined ? '' : registro.valores['ID']);
}

// ------------------------------------------------------------- Avisos
var temporizadorAviso;
function avisar(texto, esError) {
  var a = document.getElementById('aviso');
  a.textContent = texto;
  a.className = 'aviso visible' + (esError ? ' error' : '');
  clearTimeout(temporizadorAviso);
  temporizadorAviso = setTimeout(function () { a.className = 'aviso'; }, esError ? 6000 : 2600);
}

document.addEventListener('keydown', function (e) {
  if (e.key === 'Escape' && !document.getElementById('velo').hidden) cerrarEdicion();
});
</script>
